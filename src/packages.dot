digraph "packages" {
rankdir=BT
charset="utf-8"
"part3" [color="black", label=<part3>, shape="box", style="solid"];
"part3.controller" [color="black", label=<part3.controller>, shape="box", style="solid"];
"part3.main" [color="black", label=<part3.main>, shape="box", style="solid"];
"part3.obstacles" [color="black", label=<part3.obstacles>, shape="box", style="solid"];
"part3.rewards" [color="black", label=<part3.rewards>, shape="box", style="solid"];
"part3.robots" [color="black", label=<part3.robots>, shape="box", style="solid"];
"part3.verify_curriculum" [color="black", label=<part3.verify_curriculum>, shape="box", style="solid"];
"part3.warehouse_env" [color="black", label=<part3.warehouse_env>, shape="box", style="solid"];
"part3.warehouse_robot" [color="black", label=<part3.warehouse_robot>, shape="box", style="solid"];
"part3.controller" -> "part3.warehouse_env" [arrowhead="open", arrowtail="none"];
"part3.main" -> "part3.warehouse_env" [arrowhead="open", arrowtail="none"];
"part3.verify_curriculum" -> "part3.warehouse_env" [arrowhead="open", arrowtail="none"];
"part3.verify_curriculum" -> "part3.warehouse_robot" [arrowhead="open", arrowtail="none"];
"part3.warehouse_env" -> "part3.obstacles" [arrowhead="open", arrowtail="none"];
"part3.warehouse_env" -> "part3.rewards" [arrowhead="open", arrowtail="none"];
"part3.warehouse_env" -> "part3.robots" [arrowhead="open", arrowtail="none"];
"part3.warehouse_env" -> "part3.warehouse_robot" [arrowhead="open", arrowtail="none"];
}
